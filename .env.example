# CKB (testnet, Aggron4 unless you run a local node)
CKB_NODE_URL=http://127.0.0.1:28114
CKB_INDEXER_URL=http://127.0.0.1:28114

# Fiber Network Node (FNN) — target v0.9.x stable (NOT v0.10.0-rc prerelease)
FIBER_RPC_URL=http://127.0.0.1:8227

# Settler keypair (FIBER_NODE_B58) — testnet key only; never commit a funded key
SETTLER_NODE_B58=

# Provider-side x402 server (the facilitator you run)
FACILITATOR_PORT=4020
FACILITATOR_HOST=0.0.0.0

# Metered "upto" defaults
UPTO_CAP_CKB=1000        # default cap in CKB (1 CKB = 1e8 shannons)
UPTO_CAP_UDT=1000        # default cap in UDT minor units (main unit x 10^8)

# Test DB isolation (Rule 6): tests must never use the live database
TEST_DATABASE_URL=file:./test-artifacts/facilitator.test.db
